{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "henry-klatt-location-analytics",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": "dashboard",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false },
  "triggers": { "crons": ["15 3 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "henry-klatt-location-analytics",
    "database_id": "829907fb-09b2-4ae0-9009-bd2810c3b596",
    "migrations_dir": "migrations"
  }]
}
